# DO NOT COMMIT YOUR REAL .env FILE
# Containers only: PostgreSQL + Redis. API/Vite run locally.
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_PORT=5432
REDIS_PASSWORD=REPLACE_WITH_DISTINCT_REDIS_PASSWORD
REDIS_PORT=6379
Auth__SigningKey=REPLACE_WITH_64_RANDOM_CHARACTERS_OR_MORE
Auth__Issuer=vizora-api
Auth__LifetimeHours=24
Designer__Url=
Designer__TicketSigningKey=
Designer__ServerSecret=
Payments__PublicBaseUrl=http://localhost:8080
Payments__WebBaseUrl=http://localhost:5173
Payments__Wechat__MchId=
Payments__Wechat__AppId=
Payments__Wechat__SerialNo=
Payments__Wechat__PrivateKeyPem=
Payments__Wechat__ApiV3Key=
Payments__Wechat__NotifyUrl=
# For each trusted active WeChat platform cert serial set Payments__Wechat__PlatformCertificates__SERIAL=PEM via env/secure config
Payments__Alipay__AppId=
Payments__Alipay__PrivateKeyPem=
Payments__Alipay__AlipayPublicKeyPem=
Payments__Alipay__SellerId=
Payments__Alipay__NotifyUrl=
Payments__Alipay__Gateway=https://openapi.alipay.com/gateway.do

# Production email verification/password recovery, use a TLS SMTP provider
Mail__Host=
Mail__Port=587
Mail__User=
Mail__Password=
Mail__From=
Mail__EnableSsl=true

# Set true ONLY after operator-reviewed published terms/privacy and trading terms.
Legal__Ready=false
Legal__OperatorName=
Legal__ContactEmail=
# Trust only the actual reverse proxy address (never arbitrary internet forwarding headers).
# Proxy__KnownProxies__0=
